generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  single_mother
  customer
  ngo_admin
  super_admin
  waris
}

enum UserStatus {
  active
  pending
  suspended
  verified
}

enum SkillCategory {
  cooking
  sewing
  massage
  elderly_care
  cleaning
  teaching
  companionship
  shopping
  other
}

enum ProficiencyLevel {
  beginner
  intermediate
  expert
}

enum ServiceType {
  job
  food
  learning
  business
}

enum PricingType {
  per_hour
  per_session
  per_day
  per_task
  per_meal
}

enum TransportType {
  none
  motorcycle
  car
}

enum MobilityStatus {
  independent
  walking_stick
  wheelchair
  bedridden
}

enum ProviderGenderPref {
  female_only
  no_preference
}

enum BookingStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
  disputed
  refunded
}

enum PaymentStatus {
  pending
  paid
  partial
  refunded
}

enum PaymentType {
  booking_full
  booking_deposit
  top_up
  payout
  refund
  platform_fee
}

enum WalletTxType {
  credit
  debit
}

enum BackgroundCheckStatus {
  pending
  approved
  rejected
}

enum NGOStatus {
  active
  pending
  suspended
}

enum SOSStatus {
  active
  resolved
  false_alarm
}

enum EventType {
  group_meal
  cooking_class
  community_gathering
}

enum EventStatus {
  upcoming
  ongoing
  completed
  cancelled
}

model User {
  id            String     @id @default(uuid())
  email         String?    @unique
  phone         String     @unique
  passwordHash  String?    @map("password_hash")
  fullName      String     @map("full_name")
  role          UserRole
  status        UserStatus @default(pending)
  avatarUrl     String?    @map("avatar_url")
  emailVerified Boolean    @default(false) @map("email_verified")
  phoneVerified Boolean    @default(false) @map("phone_verified")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  singleMotherProfile  SingleMotherProfile?
  customerProfile      CustomerProfile?
  ngoAdmin             NGO?                 @relation("NGOAdmin")
  bookingsAsCustomer   Booking[]            @relation("CustomerBookings")
  bookingsAsProvider   Booking[]            @relation("ProviderBookings")
  bookingCancellations Booking[]            @relation("BookingCancellations")
  reviews              Review[]             @relation("Reviewer")
  reviewsReceived      Review[]             @relation("Reviewee")
  payments             Payment[]
  walletTx             WalletTransaction[]
  notifications        Notification[]
  locationLogs         LocationLog[]
  sosTriggered         SOSEvent[]           @relation("SOSTriggered")
  sosResolved          SOSEvent[]           @relation("SOSResolved")
  bookingReports       BookingReport[]
  auditLogs            AuditLog[]
  eventParticipants    EventParticipant[]
  hostedEvents         Event[]

  @@map("users")
}

model SingleMotherProfile {
  id                    String                @id @default(uuid())
  userId                String                @unique @map("user_id")
  ngoId                 String?               @map("ngo_id")
  referralCode          String?               @map("referral_code")
  locationState         String                @map("location_state")
  locationCity          String                @map("location_city")
  locationPostcode      String?               @map("location_postcode")
  locationLat           Decimal?              @map("location_lat") @db.Decimal(10, 8)
  locationLng           Decimal?              @map("location_lng") @db.Decimal(11, 8)
  childrenCount         Int                   @default(0) @map("children_count")
  childrenAges          Int[]                 @map("children_ages")
  canBringChildren      Boolean               @default(false) @map("can_bring_children")
  languages             String[]              @default(["bm"])
  hasTransport          TransportType?        @map("has_transport")
  bio                   String?
  verifiedByNgo         Boolean               @default(false) @map("verified_by_ngo")
  verifiedByAdmin       Boolean               @default(false) @map("verified_by_admin")
  backgroundCheckStatus BackgroundCheckStatus @default(pending) @map("background_check_status")
  ratingAvg             Decimal               @default(0.0) @map("rating_avg") @db.Decimal(3, 1)
  totalReviews          Int                   @default(0) @map("total_reviews")
  totalBookings         Int                   @default(0) @map("total_bookings")
  earningsTotal         Decimal               @default(0.00) @map("earnings_total") @db.Decimal(10, 2)
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ngo            NGO?                   @relation(fields: [ngoId], references: [id])
  skills         ProviderSkill[]
  pricing        ProviderPricing[]
  availabilities ProviderAvailability[]
  portfolio      ProviderPortfolio[]

  @@map("single_mother_profiles")
}

model CustomerProfile {
  id                      String              @id @default(uuid())
  userId                  String              @unique @map("user_id")
  isForSelf               Boolean             @default(true) @map("is_for_self")
  seniorFullName          String?             @map("senior_full_name")
  seniorAge               Int?                @map("senior_age")
  seniorPhone             String?             @map("senior_phone")
  seniorAvatarUrl         String?             @map("senior_avatar_url")
  locationState           String              @map("location_state")
  locationCity            String              @map("location_city")
  locationPostcode        String?             @map("location_postcode")
  locationLat             Decimal?            @map("location_lat") @db.Decimal(10, 8)
  locationLng             Decimal?            @map("location_lng") @db.Decimal(11, 8)
  healthConditions        String[]            @map("health_conditions")
  allergies               String[]
  medications             String?
  mobilityStatus          MobilityStatus?     @map("mobility_status")
  dietaryRequirements     String[]            @map("dietary_requirements")
  preferredProviderGender ProviderGenderPref? @map("preferred_provider_gender")
  preferredAgeMin         Int?                @map("preferred_provider_age_min")
  preferredAgeMax         Int?                @map("preferred_provider_age_max")
  budgetMin               Decimal?            @map("budget_min") @db.Decimal(10, 2)
  budgetMax               Decimal?            @map("budget_max") @db.Decimal(10, 2)
  needs                   String[]            @default(["job"])
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergencyContacts EmergencyContact[]

  @@map("customer_profiles")
}

model EmergencyContact {
  id                String   @id @default(uuid())
  customerProfileId String   @map("customer_profile_id")
  name              String
  relationship      String
  phone             String
  email             String?
  isPrimary         Boolean  @default(false) @map("is_primary")
  createdAt         DateTime @default(now()) @map("created_at")

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model NGO {
  id            String    @id @default(uuid())
  name          String
  regNumber     String?   @unique @map("reg_number")
  contactPerson String?   @map("contact_person")
  email         String?
  phone         String?
  address       String?
  state         String?
  city          String?
  adminUserId   String?   @unique @map("admin_user_id")
  status        NGOStatus @default(pending)
  referralCode  String?   @unique @map("referral_code")
  totalMembers  Int       @default(0) @map("total_members")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  adminUser User?                 @relation("NGOAdmin", fields: [adminUserId], references: [id])
  members   SingleMotherProfile[]

  @@map("ngos")
}

model ProviderSkill {
  id             String            @id @default(uuid())
  profileId      String            @map("profile_id")
  skillName      String            @map("skill_name")
  skillCategory  SkillCategory     @map("skill_category")
  proficiency    ProficiencyLevel?
  yearsExp       Int?              @map("years_experience")
  hasCertificate Boolean           @default(false) @map("has_certificate")
  certificateUrl String?           @map("certificate_url")
  createdAt      DateTime          @default(now()) @map("created_at")

  profile SingleMotherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("provider_skills")
}

model ProviderPricing {
  id          String      @id @default(uuid())
  profileId   String      @map("profile_id")
  serviceType ServiceType @map("service_type")
  pricingType PricingType @map("pricing_type")
  price       Decimal     @db.Decimal(10, 2)
  currency    String      @default("MYR")
  description String?
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  profile SingleMotherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("provider_pricing")
}

model ProviderAvailability {
  id           String    @id @default(uuid())
  profileId    String    @map("profile_id")
  dayOfWeek    Int       @map("day_of_week")
  startTime    String    @map("start_time")
  endTime      String    @map("end_time")
  isRecurring  Boolean   @default(true) @map("is_recurring")
  specificDate DateTime? @map("specific_date") @db.Date
  isAvailable  Boolean   @default(true) @map("is_available")
  createdAt    DateTime  @default(now()) @map("created_at")

  profile SingleMotherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("provider_availabilities")
}

model ProviderPortfolio {
  id          String   @id @default(uuid())
  profileId   String   @map("profile_id")
  title       String?
  description String?
  imageUrl    String   @map("image_url")
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")

  profile SingleMotherProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("provider_portfolios")
}

model Booking {
  id                 String        @id @default(uuid())
  bookingCode        String        @unique @map("booking_code")
  customerId         String        @map("customer_id")
  providerId         String        @map("provider_id")
  serviceType        ServiceType   @map("service_type")
  status             BookingStatus @default(pending)
  scheduledDate      DateTime      @map("scheduled_date") @db.Date
  startTime          String        @map("start_time")
  endTime            String?       @map("end_time")
  durationHours      Int?          @map("duration_hours")
  locationAddress    String?       @map("location_address")
  locationLat        Decimal?      @map("location_lat") @db.Decimal(10, 8)
  locationLng        Decimal?      @map("location_lng") @db.Decimal(11, 8)
  isCustomerLocation Boolean       @default(true) @map("is_customer_location")
  requirements       String?
  specialNotes       String?       @map("special_notes")
  dietaryNotes       String?       @map("dietary_notes")
  providerPrice      Decimal       @map("provider_price") @db.Decimal(10, 2)
  platformFee        Decimal       @map("platform_fee") @db.Decimal(10, 2)
  totalAmount        Decimal       @map("total_amount") @db.Decimal(10, 2)
  paymentStatus      PaymentStatus @default(pending) @map("payment_status")
  paymentMethod      String?       @map("payment_method")
  requestedAt        DateTime      @default(now()) @map("requested_at")
  confirmedAt        DateTime?     @map("confirmed_at")
  checkedInAt        DateTime?     @map("checked_in_at")
  checkedOutAt       DateTime?     @map("checked_out_at")
  completedAt        DateTime?     @map("completed_at")
  cancelledAt        DateTime?     @map("cancelled_at")
  cancelledBy        String?       @map("cancelled_by")
  cancellationReason String?       @map("cancellation_reason")
  sosTriggered       Boolean       @default(false) @map("sos_triggered")
  sosTriggeredAt     DateTime?     @map("sos_triggered_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  customer        User            @relation("CustomerBookings", fields: [customerId], references: [id])
  provider        User            @relation("ProviderBookings", fields: [providerId], references: [id])
  cancelledByUser User?           @relation("BookingCancellations", fields: [cancelledBy], references: [id])
  reports         BookingReport[]
  reviews         Review[]
  payments        Payment[]
  locationLogs    LocationLog[]
  sosEvents       SOSEvent[]

  @@map("bookings")
}

model BookingReport {
  id                String   @id @default(uuid())
  bookingId         String   @map("booking_id")
  providerId        String   @map("provider_id")
  reportText        String?  @map("report_text")
  photos            String[]
  tasksCompleted    String[] @map("tasks_completed")
  customerCondition String?  @map("customer_condition")
  createdAt         DateTime @default(now()) @map("created_at")

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider User    @relation(fields: [providerId], references: [id])

  @@map("booking_reports")
}

model LocationLog {
  id         String   @id @default(uuid())
  bookingId  String?  @map("booking_id")
  userId     String   @map("user_id")
  lat        Decimal  @db.Decimal(10, 8)
  lng        Decimal  @db.Decimal(11, 8)
  accuracy   Decimal? @db.Decimal(10, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")

  booking Booking? @relation(fields: [bookingId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@map("location_logs")
}

model SOSEvent {
  id          String    @id @default(uuid())
  bookingId   String?   @map("booking_id")
  triggeredBy String    @map("triggered_by")
  lat         Decimal?  @db.Decimal(10, 8)
  lng         Decimal?  @db.Decimal(11, 8)
  reason      String?
  status      SOSStatus @default(active)
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?   @map("resolved_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  booking   Booking? @relation(fields: [bookingId], references: [id])
  triggerer User     @relation("SOSTriggered", fields: [triggeredBy], references: [id])
  resolver  User?    @relation("SOSResolved", fields: [resolvedBy], references: [id])

  @@map("sos_events")
}

model Review {
  id           String    @id @default(uuid())
  bookingId    String    @map("booking_id")
  reviewerId   String    @map("reviewer_id")
  revieweeId   String    @map("reviewee_id")
  rating       Int
  comment      String?
  categories   Json?
  isPublic     Boolean   @default(true) @map("is_public")
  responseText String?   @map("response_text")
  respondedAt  DateTime? @map("responded_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewer User    @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewee User    @relation("Reviewee", fields: [revieweeId], references: [id])

  @@map("reviews")
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String?       @map("booking_id")
  userId        String        @map("user_id")
  amount        Decimal       @db.Decimal(10, 2)
  type          PaymentType
  status        PaymentStatus @default(pending)
  paymentMethod String?       @map("payment_method")
  transactionId String?       @map("transaction_id")
  billplzId     String?       @map("billplz_id")
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at")

  booking Booking? @relation(fields: [bookingId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@map("payments")
}

model WalletTransaction {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  type          WalletTxType
  amount        Decimal      @db.Decimal(10, 2)
  balanceAfter  Decimal      @map("balance_after") @db.Decimal(10, 2)
  referenceType String?      @map("reference_type")
  referenceId   String?      @map("reference_id")
  description   String?
  createdAt     DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("wallet_transactions")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String
  message   String?
  data      Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  actionUrl String?   @map("action_url")
  sentVia   String[]  @default(["push"]) @map("sent_via")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Event {
  id                  String      @id @default(uuid())
  title               String
  description         String?
  eventType           EventType   @map("event_type")
  hostId              String?     @map("host_id")
  locationAddress     String?     @map("location_address")
  locationLat         Decimal?    @map("location_lat") @db.Decimal(10, 8)
  locationLng         Decimal?    @map("location_lng") @db.Decimal(11, 8)
  eventDate           DateTime    @map("event_date") @db.Date
  startTime           String      @map("start_time")
  endTime             String?     @map("end_time")
  maxParticipants     Int         @map("max_participants")
  currentParticipants Int         @default(0) @map("current_participants")
  costPerPerson       Decimal     @default(0.00) @map("cost_per_person") @db.Decimal(10, 2)
  currency            String      @default("MYR")
  menuDescription     String?     @map("menu_description")
  dietaryOptions      String[]    @map("dietary_options")
  status              EventStatus @default(upcoming)
  imageUrl            String?     @map("image_url")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  host         User?             @relation(fields: [hostId], references: [id])
  participants EventParticipant[]

  @@map("events")
}

model EventParticipant {
  id            String   @id @default(uuid())
  eventId       String   @map("event_id")
  userId        String   @map("user_id")
  status        String   @default("registered")
  paymentStatus String   @default("pending") @map("payment_status")
  registeredAt  DateTime @default(now()) @map("registered_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_participants")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
